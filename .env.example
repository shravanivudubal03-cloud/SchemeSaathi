# GEMINI_API_KEY: Optional cloud LLM fallback for extraction/explanation when local Ollama is unreachable.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OLLAMA_BASE_URL: Local or remote Ollama server URL for citizen profile JSON extraction & plain-language explanations.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
